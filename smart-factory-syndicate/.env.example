# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_factory
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_factory

# Redis
REDIS_URL=redis://localhost:6379/0

# Fleetbase Logistics OS Integration
FLEETBASE_HOST=http://localhost:8000
FLEETBASE_API_KEY=flb_live_demo_key
FLEETBASE_ORGANIZATION_ID=org_factory_cluster_01

# AI & LLM Providers
OPENAI_API_KEY=sk-demo-key-replace-with-yours
OPENAI_MODEL=gpt-4o

# Server Ports
BACKEND_AI_PORT=8000
BACKEND_GATEWAY_PORT=5000
FRONTEND_PORT=3000

